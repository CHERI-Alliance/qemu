# Generic "-cpu rv64,..." / "-cpu rv32,..." equivalents of the named Codasip
# CPUs defined in target/riscv/cpu.c.  Each string enables the same ISA
# extensions, MMU type, PMP, PMU counter count and privileged spec version as
# the named CPU, so that extra extension properties can be appended to it
# (the named CPUs do not accept extension properties).  The generic CPUs do
# not register the Codasip custom CSRs.
#
# The strings are for the riscv{32,64}cheristd targets; the cores without
# CHERI turn the CHERI extensions off explicitly, since the generic CPUs
# enable them by default on those targets.

# RV64, CHERI
export CODASIP_X730="rv64,i=on,m=on,a=on,f=on,d=on,c=on,s=on,u=on,h=off,v=off,priv_spec=v1.12.0,mmu=on,pmp=off,sv39=on,pmu-num=4,Zicsr=on,Zifencei=on,Zihintpause=on,zicbom=on,zicboz=on,cbom_blocksize=64,cboz_blocksize=64,zba=on,zbb=on,zbc=off,zbs=on,zbkb=on,zbkc=on,zkt=on,Zfhmin=on,Zfa=off,Zawrs=off,zca=on,zcb=on,zcd=on,zcf=off,svinval=on,svnapot=on,svpbmt=on,svadu=off,sstc=on,sscofpmf=on,y=on,Zyhybrid=on,Zylevels1=on,Svucrg=on,zish4add=on"
export CODASIP_X730_LUX="$CODASIP_X730"
